# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional overrides (defaults shown)
#DATABASE_PATH=data/tgdl.db
#DOWNLOAD_DIR=data/downloads
#MAX_FILE_SIZE_MB=48
#MAX_HEIGHT=720
#MAX_CONCURRENT_DOWNLOADS=3
#MAX_PER_USER_CONCURRENT=1
#DOWNLOAD_TIMEOUT_S=300
#LOG_LEVEL=INFO

# Optional: in groups, download any link to a known media platform (YouTube, TikTok,
# Instagram, X, Twitch, Pinterest, Reddit) without needing an @mention — so everyone
# can just paste a link. Links to hosts the bot doesn't recognize are ignored in
# silence, with no error reply, so ordinary chatter about articles and docs stays
# undisturbed. Mentioning the bot still forces an attempt on any link at all.
# Groups only: channel posts always require the mention.
#GROUP_AUTO_DOWNLOAD=false

# Optional: Telegram user id allowed to run /stats (an ops summary: counts, cache hit
# rate, per-platform latency). Unset or 0 disables the command completely — for anyone
# else it silently does nothing, so it doesn't even reveal that it exists. The id is
# only ever compared in memory and is never written to the audit database.
#ADMIN_USER_ID=123456789

# Optional: DM that admin when the BOT looks unhealthy — a broken ffmpeg, an expired
# Instagram session, a burst of YouTube bot-checks. Ordinary user-level failures
# ("unsupported link", "too large") never alert, and each alert kind is rate-limited
# to at most one message an hour. Requires ADMIN_USER_ID; set 0/false to keep /stats
# without the DMs. Alerts name the link, platform and error — never who asked.
#ADMIN_ALERTS=true

# --- Optional: self-hosted Bot API server (raises the upload cap 50 MB -> 2 GB) ---
#
# Telegram's cloud Bot API refuses uploads over 50 MB, which is where MAX_FILE_SIZE_MB=48
# comes from. Running your own `telegram-bot-api` server lifts that to 2 GB:
#
#   1. Get an API ID and hash from https://my.telegram.org (API development tools).
#      These are separate from the BotFather token and identify the *server*, not the bot.
#   2. Start it:  docker compose --profile local-api up -d
#   3. Point the bot at it and raise the cap (720p rarely needs 1.5 GB — but long
#      videos no longer fail):
#        TELEGRAM_API_URL=http://telegram-bot-api:8081
#        MAX_FILE_SIZE_MB=1500
#
# ONE-TIME CAVEAT: a token that has already been used against the cloud API must be
# released from it first, or the local server rejects it. Call logOut once against the
# CLOUD API (https://core.telegram.org/bots/api#logout):
#   curl -X POST "https://api.telegram.org/bot<YOUR_TOKEN>/logOut"
# Then start the bot against the local server. This is deliberately not automated —
# it is irreversible for the current session and would be a bad thing to do by accident.
#TELEGRAM_API_URL=http://telegram-bot-api:8081
#TELEGRAM_API_ID=1234567
#TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: Netscape-format cookies.txt exports, kept in PER-PLATFORM jars so each
# site only ever receives its own credentials:
#  - YOUTUBE_COOKIES: used only for YouTube. Fixes "confirm you're not a bot" on
#    datacenter IPs (most VPS/Coolify hosts). Without it the bot falls back through
#    alternate player clients (android/ios/tv), which handles many but not all cases.
#  - INSTAGRAM_COOKIES: used only for Instagram — and only for stories (always
#    login-gated) plus a single retry when a post turns out to be login-walled.
#    Public reels/posts are fetched anonymously so the account isn't flagged.
#  - COOKIES: generic jar for any platform without a dedicated one above.
# Use throwaway accounts; cookies are credentials.
#
# Each jar accepts the cookies *content* via env var (recommended on PaaS: the raw
# cookies.txt text or its base64 — `base64 -w0 cookies.txt`, auto-detected;
# materialized to a private temp file at startup, never the data volume), or a
# *_FILE path on disk. Content wins over the path when both are set.
#YOUTUBE_COOKIES=<base64 of youtube cookies.txt>
#INSTAGRAM_COOKIES=<base64 of instagram cookies.txt>
#COOKIES=<base64 of cookies.txt>
#YOUTUBE_COOKIES_FILE=data/youtube-cookies.txt
#INSTAGRAM_COOKIES_FILE=data/instagram-cookies.txt
#COOKIES_FILE=data/cookies.txt
