# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional overrides (defaults shown)
#DATABASE_PATH=data/tgdl.db
#DOWNLOAD_DIR=data/downloads
#MAX_FILE_SIZE_MB=48
#MAX_HEIGHT=720
#MAX_CONCURRENT_DOWNLOADS=3
#MAX_PER_USER_CONCURRENT=1
#DOWNLOAD_TIMEOUT_S=300
#LOG_LEVEL=INFO

# Optional: Netscape-format cookies.txt from a logged-in browser, shared by both
# download engines (yt-dlp and gallery-dl). Needed for:
#  - YouTube on datacenter IPs (most VPS/Coolify hosts): "confirm you're not a bot".
#    Without cookies the bot falls back through alternate player clients
#    (android/ios/tv), which handles many but not all cases.
#  - Instagram stories (always login-gated) and some Instagram/X posts.
# Export from one browser profile logged into all relevant sites so one export
# covers everything. Use a throwaway account; the cookies are a credential.
#
# Preferred: pass the cookies *content* via env var — easiest on PaaS dashboards.
# The value may be the raw cookies.txt text or its base64 encoding (recommended:
# `base64 -w0 cookies.txt`); both are auto-detected. Materialized to a private
# temp file at startup, never written to the data volume.
#COOKIES=<base64 of cookies.txt>
# Legacy-named alias, same behavior:
#YOUTUBE_COOKIES=<base64 of cookies.txt>
#
# Alternative: point at a file on disk (e.g. a mounted volume). Content vars win
# over file paths when both are set.
#COOKIES_FILE=data/cookies.txt
#YOUTUBE_COOKIES_FILE=data/cookies.txt
