# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional overrides (defaults shown)
#DATABASE_PATH=data/tgdl.db
#DOWNLOAD_DIR=data/downloads
#MAX_FILE_SIZE_MB=48
#MAX_HEIGHT=720
#MAX_CONCURRENT_DOWNLOADS=3
#MAX_PER_USER_CONCURRENT=1
#DOWNLOAD_TIMEOUT_S=300
#LOG_LEVEL=INFO

# Optional: path to a Netscape-format cookies.txt exported from a logged-in browser.
# Shared by both download engines (yt-dlp and gallery-dl). Needed for:
#  - YouTube on datacenter IPs (most VPS/Coolify hosts): "confirm you're not a bot".
#    Without cookies the bot falls back through alternate player clients
#    (android/ios/tv), which handles many but not all cases.
#  - Instagram stories (always login-gated) and some Instagram/X posts.
# Export from one browser profile logged into all relevant sites so a single file
# covers everything. Use a throwaway account; the file is a credential.
#COOKIES_FILE=data/cookies.txt
# Legacy alias, same behavior (kept for existing deployments):
#YOUTUBE_COOKIES_FILE=data/cookies.txt
