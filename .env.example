# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional overrides (defaults shown)
#DATABASE_PATH=data/tgdl.db
#DOWNLOAD_DIR=data/downloads
#MAX_FILE_SIZE_MB=48
#MAX_HEIGHT=720
#MAX_CONCURRENT_DOWNLOADS=3
#MAX_PER_USER_CONCURRENT=1
#DOWNLOAD_TIMEOUT_S=300
#LOG_LEVEL=INFO

# Optional: path to a Netscape-format cookies.txt exported from a logged-in browser.
# On datacenter IPs (most VPS/Coolify hosts) YouTube may demand "confirm you're not
# a bot"; a cookies file is the reliable fix. Without it, the bot falls back through
# alternate player clients (android/ios/tv), which handles many but not all cases.
#YOUTUBE_COOKIES_FILE=data/cookies.txt
